DISCORD_TOKEN=your_discord_bot_token
DASHBOARD_PASSWORD=replace-with-a-unique-random-password-at-least-12-characters
# Optional username paired with DASHBOARD_PASSWORD. Defaults to admin.
ADMIN_USERNAME=admin
# Optional additional bootstrap account. Stored as a scrypt hash on first run.
ADMIN_PASSWORD=
# Optional public HTTPS URL used for ticket transcript links.
DOMAIN_URL=
# Optional stable session signing key; generate a unique random value.
SESSION_SECRET=
# Optional: register slash commands in one server for immediate testing.
GUILD_ID=1551649417701101759
# Optional: put tickets under this category and allow this role into them.
TICKET_CATEGORY_ID=
SUPPORT_ROLE_ID=1553477030614671411
# The dashboard binds to localhost by default. Do not expose it publicly without auth.
HOST=127.0.0.1
PORT=3000
